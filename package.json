{
  "name": "gaokao-kg",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler pages dev dist --port 4174",
    "test": "node --test tests/*.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply gaokao-kg --local",
    "db:migrate": "wrangler d1 migrations apply gaokao-kg --remote",
    "deploy": "npm run build && wrangler pages deploy dist --branch main"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  }
}
